# Qinxiao Music (@QinxiaoMusicBot) Configuration

# Telegram API Credentials
BOT_TOKEN=your_telegram_bot_token_here
API_ID=12345678
API_HASH=your_api_hash_here
ASSISTANT_SESSION=
ASSISTANT_PHONE=

# Bot Owner & Security
OWNER_ID=123456789
SUDO_USERS=123456789,987654321

# Bot Identity
BOT_NAME=Qinxiao Music
BOT_USERNAME=@QinxiaoMusicBot

# System Paths & Execution
FFMPEG_PATH=ffmpeg

# Database Configuration
# SQLite (Default): sqlite+aiosqlite:///qinxiao_music.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/qinxiao_db
DATABASE_URL=sqlite+aiosqlite:///qinxiao_music.db

# Cache Configuration (Optional Redis)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Third-Party Music & Lyrics API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
LYRICS_API_KEY=your_lyrics_api_key

# Default Playback Limits & Settings
MAX_QUEUE_SIZE=50
DEFAULT_VOLUME=100
DEFAULT_QUALITY=high
DEFAULT_BITRATE=320k
AUTO_LEAVE_TIMEOUT=180
VOTE_SKIP_PERCENTAGE=50
